    "@remotion/three": "^4.0.538",
    "@remotion/zod-types": "^4.0.538",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "^4.0.538",
    "three": "^0.186.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
